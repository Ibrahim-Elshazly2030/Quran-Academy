# إعدادات منظومة إدارة الأكاديمية والمدرسة القرآنية (Furqan Quran Academy)
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=-your_internal_secret
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
PORT=8005

# إعدادات HTTPS للإنتاج
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# قاعدة البيانات في الإنتاج
USE_POSTGRESQL=True
DB_NAME=quran_academy_db
DB_USER=postgres
DB_PASSWORD=881981
DB_HOST=127.0.0.1
DB_PORT=5432

# إعدادات اللغة والمنطقة الزمنية
LANGUAGE_CODE=ar
TIME_ZONE=Asia/Riyadh
